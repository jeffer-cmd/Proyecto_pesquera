<style>
    .input-busqueda {
        width: 300px;
    }

    @media (max-width: 991.98px) {

        .input-busqueda {
            width: 100%;
        }

    }
</style>

<h1>Gestión de productos</h1>

<div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-center">
{{!-- <div class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-3 my-4"></div> --}}

    <a class="btn btn-warning text-white my-5" href="/gestion_productos/form_producto">Crear producto</a>

    {{!-- <input type="text" id="buscador" class="form-control mb-3 w-50 border border-dark" placeholder="Buscar producto">

    <a class="btn btn-warning text-white my-5" id="btnBuscar" href= "/gestion_productos/productos">Buscar producto</a> --}}
    <form action="/gestion_productos/productos" method="POST" class="d-flex flex-column flex-lg-row gap-2 align-items-center">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <input class="form-control input-busqueda mx-5" type="text" name="nombre" placeholder="Buscar producto">

        <button type="submit" class=" form-control btn btn-warning text-white mx-2 my-4">
            Buscar
        </button>

    </form>
</div>

<div class="table-responsive">
    <table class="table table-sm table-bordered table-hover text-center align-middle" id="tablaProductos">

        <thead class="table-primary align-middle">
            <tr>
                <th>NOMBRE PRODUCTO</th>
                <th>CÓDIGO DE MATERIAL</th>
                <th>PROVEEDOR</th>

                <th>UNIDAD DE MEDIDA</th>
                <th>CATEGORÍA</th>
                {{!-- esto se trae de compras --}}
                <th>PRECIO COMPRA</th> 
                <th>PRECIO VENTA</th>
                <th>FECHA DE CREACIÓN</th>
                <th class="" style="width: 150px;">ACCIONES</th>
            </tr>
        </thead>

        <tbody>

            {{#each lista_productos}}

                {{>card_productos item=this}}
            
            
            {{/each}}
        </tbody>

    </table>
</div>

