    <div class="row g-2 my-4">

        <div class="col-12 col-lg-auto">
            <a href="/gestion_ventas/ventas_anuladas"
            class="btn btn-primary w-100 my-2">
                Ventas anuladas
            </a>
        </div>

        <div class="col-12 col-lg-auto">
            <a href="/gestion_compras/compras_anuladas"
            class="btn btn-primary w-100 my-2">
                Compras anuladas
            </a>
        </div>

        <div class="col-12 col-lg">
            <form action="/gestion_inventario/inventario"
                method="POST"
                class="d-flex flex-column flex-lg-row gap-2">

                <input type="hidden" name="_csrf" value="{{csrfToken}}" />

                <input
                    class="form-control input-busqueda flex-grow-1 my-2"
                    type="text"
                    name="busqueda"
                    placeholder="Buscar lote, producto, tipo o estado"
                >

                <button type="submit"
                        class="btn btn-warning text-white my-2">
                    Buscar
                </button>

            </form>
        </div>

    </div>

</div>

    <div class="table-responsive">
        <table class="table table-sm table-bordered table-hover text-center align-middle" id="tablaInventario">

            <thead class="table-primary align-middle">
                <tr>
                    <th>PRODUCTO</th>
                    <th>LOTE</th>
                    <th>TIPO</th>
                    {{!-- <th>ESTADO</th> --}}
                    <th>CANTIDAD</th>

                    <th>FECHA DE REGISTRO</th>
                    <th>ESTADO</th>
                
                </tr>
            </thead>

            <tbody>

                {{#each lista_inventario}}

                    {{>card_inventario item=this}}
                
                
                {{/each}}
            </tbody>

        </table>

    </div>

</div>

<script src="/filtro_inventario.js"> </script>