<tr>
    <td>{{item.nombre}}</td>
    <td>{{item.email}}</td>
    <td>{{item.rol}}</td>
    <td>
        {{#if item.cuentaConfirmada}}
                SI
        {{else}}
                NO
        {{/if}}
    </td>
    <td>{{item.createdAt}}</td>

    <td class="text-nowrap">
        <div class="d-flex justify-content-center gap-2">
            <a href="/gestion_usuarios/form_editar_user/{{item.id}}" class="btn btn-warning btn-sm">✏️</a>
            <a href="/gestion_usuarios/eliminar_users/{{item.id}}" class="btn btn-danger btn-sm">🗑️</a>

        </div>
    </td>
</tr>

