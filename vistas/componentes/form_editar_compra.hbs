<h1>Edición de compra</h1>

{{#if detalle_compra.id }}

    <form action="/gestion_compras/form_editar_compra/{{detalle_compra.id}}" method="post">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />


            <label for="" class="my-2">Producto</label>
            <select class="form-select mb-2 select2" name="id_producto">

            

                {{#each productos}}

                        
                        <option 
                            value="{{this.id}}"

                            {{#if (eq this.id ../detalle_compra.productoId)}}
                                selected
                            {{/if}}
                        >
                            {{this.nombre}}-{{this.codigoMaterial}}
                        </option>

                    {{/each}}

            </select>

            <label class="my-2">Tipo de embalaje</label>
            <select class="form-select my-2" name="id_embalaje">

                {{#each embalajes}}
                    <option
                        value="{{this.id_embalaje}}"

                        {{#if (eq this.id ../detalle_compra.idEmbalaje)}}
                                selected
                        {{/if}}
                            >
                            {{this.nombre_embalaje}}

                </option> 

                        
                    {{/each}}
            </select>

            
            {{!-- <label class="mt-2">Cantidad de embalaje</label>
            <input type="number"
                class="form-control"
                name="cantidad_embalaje"
                min="0"> --}}

            <!-- UNIDADES POR CAJA -->
            {{!-- <label class="mt-2">Unidades por embalaje</label>
            <input type="number"
                class="form-control"
                name="unidades_embalaje"
                min="1"
                value="{{parseInt detalle_compra.cantidad}}"
                required
                oninvalid="this.setCustomValidity('Ingrese la cantidad de unidades por embalaje')"
                oninput="this.setCustomValidity('')"> --}}

        

            <!-- PRECIO -->
            <label class="mt-2">Precio de compra</label>
            <input type="number"
            class="form-control my-2"
            name="precio"
            value="{{parseInt detalle_compra.precio}}"
            required>

            <!-- VENCIMIENTO (Lotes) -->
            <label class="mt-2">Fecha vencimiento</label>
            <input type="date"
                class="form-control my-2"
                name="vencimiento"
                value="{{detalle_compra.fechaVencimiento}}">

            <!-- OBSERVACIONES POR ITEM -->
            <label>Observaciones de la compra</label>
            <br>
            <textarea name="observaciones" rows="3" class="my-2"> {{detalle_compra.observaciones}}</textarea>   

        
        <button type="submit" class="btn btn-warning w-100 mb-2">Editar compra</button>
    </form>
{{/if}}