                <div class="mt-4">

                    <h5 class="mb-2">
                        PRODUCTOS A VENDER
                    </h5>

                    <div class="table-responsive">

                        <table class="table table-bordered  align-middle mb-2">

                            <thead class="table-light text-center">

                                <tr>
                                    <th>PRODUCTO</th>
                                    <th style="min-width: 200px;">LOTE</th>
                                    <th>CANT.<br> EMPAQUE</th>
                                    {{!-- <th>CIUDAD</th> --}}
                                    <th>CANT.<br>PEDIDA CLIENTE</th>
                                    <th>MED.</th>
                                    <th>TALLA</th>
                                    <th>CANT.<br>REAL KG</th>
                                    <th>VR UNIT.</th>
                                    <th>OBSERVACION</th>
                                    <th>ELIMINAR FILA</th>
                                    
                                </tr>

                            </thead>

                            <tbody id="lotes-container">
                                <template id="lote-template">

                                    <tr class="lote-row">

                                        <!-- PRODUCTO -->
                                        <td>
                                            <select
                                                class="form-select form-select-sm producto-select"
                                                name="lotes[0][productoId]"
                                                required
                                            >

                                                <option value="">
                                                    Seleccione
                                                </option>

                                                {{#each productos}}

                                                    <option value="{{this.id}}">
                                                        {{this.nombre}} - {{this.codigoMaterial}}
                                                    </option>

                                                {{/each}}

                                            </select>
                                        </td>


                                        <!-- LOTE -->
                                        <td>
                                            <select
                                                class="form-select form-select-sm lote-select" style="min-width: 200px;"
                                                name="lotes[0][loteId]"
                                                required
                                            >

                                                <option value="">
                                                    Seleccione
                                                </option>

                                            </select>
                                        </td>


                                        <!-- CAJAS -->
                                        <td>
                                            <input
                                                type="number"
                                                class="form-control form-control-sm"
                                                name="lotes[0][cajas]"
                                                min="0"
                                            >
                                        </td>


                                        <!-- CIUDAD -->
                                        {{!-- <td>
                                            <input
                                                type="text"
                                                class="form-control form-control-sm"
                                                name="lotes[0][ciudad]"
                                            >
                                        </td> --}}


                                        <!-- CANTIDAD SOLICITADA -->
                                        <td>
                                            <input
                                                type="number"
                                                class="form-control form-control-sm"
                                                name="lotes[0][unidadesSolicitadas]"
                                                min="0.01"
                                                step="0.01"
                                                required
                                            >
                                        </td>


                                        <!-- MEDIDA -->
                                        <td>
                                            <input
                                                type="text"
                                                class="form-control form-control-sm"
                                                name="lotes[0][Medida]"
                                            >
                                        </td>


                                        <!-- TALLA -->
                                        <td>
                                            <input
                                                type="text"
                                                class="form-control form-control-sm"
                                                name="lotes[0][Talla]"
                                            >
                                        </td>


                                        <!-- KG -->
                                        <td>
                                            <input
                                                type="number"
                                                class="form-control form-control-sm"
                                                name="lotes[0][unidadesPorCaja]"
                                                min="0.01"
                                                step="0.01"
                                                required
                                                oninvalid="this.setCustomValidity('Ingrese una cantidad de kg válida')"
                                                oninput="this.setCustomValidity('')"
                                            >
                                        </td>


                                        <!-- PRECIO -->
                                        <td>
                                            <input
                                                type="number"
                                                class="form-control form-control-sm"
                                                name="lotes[0][precio]"
                                                min="0"
                                                {{!-- step="0.01" --}}
                                                required
                                            >
                                        </td>


                                        <!-- OBSERVACIONES -->
                                        <td>
                                            <textarea
                                                class="form-control form-control-sm"
                                                name="lotes[0][observaciones]"
                                                rows="1"
                                            ></textarea>
                                        </td>


                                        <!-- ELIMINAR -->
                                        <td class="text-center">

                                            <button
                                                type="button"
                                                class="btn btn-outline-danger btn-sm eliminar-fila"
                                                title="Eliminar lote"
                                            >
                                                ×
                                            </button>

                                        </td>

                                    </tr>

                                </template>
                            </tbody>

                        </table>

                    </div>

                    <button
                        type="button"
                        class="btn btn-outline-secondary btn-sm"
                        onclick="agregarlote()"
                    >
                        + Agregar lote
                    </button>

                </div>




                    {{!-- <div id="lotes-container">


                    </div> --}}

                    {{!-- <button type="button" class="btn btn-secondary w-100 mb-2"  onclick="agregarlote()">
                        + Agregar lote
                    </button> --}}
                    


                <button type="submit" class="btn btn-primary w-100 mb-2 my-3">Guardar venta</button>
        </form>
    </div>
</div>

