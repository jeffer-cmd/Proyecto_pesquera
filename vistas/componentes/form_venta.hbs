<div class="row justify-content-center">
    <div class="col-md-6">
        <form action="/gestion_ventas/form_venta" method="post">
                <input type="hidden" name="_csrf" value="{{csrfToken}}" />




                

                    <label for="" class="my-3">Nombre de cliente</label>
                    <input type="text" name="cliente" 
                    required
                    >

                    <br>

                    <label for="" class="my-3">Escoja el método de pago</label>
                            
                    <br>

                    <label for="transferencia" class="my-3">Transferencia</label>
                    <input
                        class="mx-3"
                        name="metodoPago"
                        type="radio"
                        value="transferencia"
                        id="transferencia"
                        required

                    />

                    <label for="tarjeta" class="my-3">Tarjeta</label>
                    <input
                        class="mx-3"
                        name="metodoPago"
                        type="radio"
                        value="tarjeta",
                        id="tarjeta"

                    />

                    <label for="efectivo" class="my-3">Efectivo</label>
                    <input
                        class="mx-3"
                        name="metodoPago"
                        type="radio"
                        value="efectivo",
                        id="efectivo"

                    />
                    <br>

                

                    <h5>PRODUCTOS A VENDER</h5>

                    <template id="lote-template">

                            <div class="lote-row border p-3 mb-2">
                                    
                            <label for="" class="my-3">Producto</label>
                            <select class="form-select producto-select  mb-2 " name="lotes[0][productoId]" >

                                <option value="">Seleccione un producto</option>

                                {{#each productos}}

                                    <option value="{{this.id}}">
                                        {{this.nombre}}
                                    </option>

                                {{/each}}

                            </select>

                                <!-- lote -->
                                <label>lote</label>
                                <select class="form-select  lote-select" name="lotes[0][loteId]">
                                    <option value="">Seleccione lote</option>
                                
                                    
                                </select>

                                
                                <label class="mt-2">Cantidad de embalaje</label>
                                <input type="number"
                                    class="form-control"
                                    name="lotes[0][cajas]"
                                    min="0">

                                
                                <label class="mt-2">Unidades por embalaje</label>
                                <input type="number"
                                    class="form-control"
                                    name="lotes[0][unidadesPorCaja]"
                                    min="1"
                                    required
                                    oninvalid="this.setCustomValidity('Ingrese la cantidad de unidades por embalaje')"
                                    oninput="this.setCustomValidity('')">

                            

                            
                                <label class="mt-2">Precio de venta</label>
                                <input type="number"
                                class="form-control"
                                name="lotes[0][precio]"
                                required
                                >

                                
                                <label>Observaciones de la venta</label>
                                <br>
                                <textarea name="lotes[0][observaciones]" rows="3"></textarea>

                        <hr>
                                <button
                                type="button"
                                class="btn btn-danger btn-sm eliminar-fila"
                            >
                                Eliminar

                            </button>
                            </div>

                        

                        </template>
                    <div id="lotes-container">


                    </div>

                    <button type="button" class="btn btn-secondary w-100 mb-2"  onclick="agregarlote()">
                        + Agregar lote
                    </button>
                    


                <button type="submit" class="btn btn-primary w-100 mb-2">Guardar venta</button>
        </form>
    </div>
</div>

