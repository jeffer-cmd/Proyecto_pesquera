<style>

    .navbar-nav,
    .navbar-toggler {
        display: none !important;
    }
    .soloAdmin {
        display: none;
    
    }



    .operacion-navbar{
        display: none;
    }
</style>



<h1 class="text-center my-5">Registro de usuarios</h1>
<div class="row justify-content-center">
    <div class="col-md-6">
        <form action="/sesion/register" method="post">
            <input type="hidden" name="_csrf" value="{{csrfToken}}" />
            <label for="" class="my-3">Nombre</label>
            <input
                class="form-control mb-2"
                name="nombre"
                placeholder="Ingrese nombre"
                type="text"
                
            />

            <label for="" class="my-3">Escoja su rol:</label>
            <br>

            <label for="admin" class="my-3">Administrador</label>
            <input
                class="mx-3"
                name="rol"
                placeholder="Ingrese el rol a desempeñar"
                type="radio"
                value="admin",
                id="admin"

            />

            <label for="empleado" class="my-3">Empleado operario</label>
            <input
                class="mx-3"
                name="rol"
                placeholder="Ingrese el rol a desempeñar"
                type="radio"
                value="empleado",
                id="empleado",
                required

            />
            <br>

            <label for="" class="my-3">Correo</label>
            <input
                class="form-control mb-2"
                name="email"
                placeholder="Ingrese email"
                type="email"
                value="pesqueramarinero@gmail.com"
                readonly
            />
            <label for="" class="my-3">Contraseña</label>
            <input
                class="form-control mb-2"
                name="password"
                placeholder="Ingrese contraseña"
                type="password"
                
            />
            <label for="" class="my-3">Repita contraseña</label>            
            <input
                class="form-control mb-2"
                name="passwordRepit"
                placeholder="Repita contraseña"
                type="password"
                
            />
            <button type="submit" class="btn btn-primary my-3">Crear Cuenta</button>
        </form>
    </div>
</div>