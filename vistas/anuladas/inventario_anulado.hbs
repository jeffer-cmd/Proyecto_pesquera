
<h1>Gestión de inventario</h1>

<div class="container">

  

        <form action="/gestion_inventario/inventario_anulado" method="POST">
            <input type="hidden" name="_csrf" value="{{csrfToken}}" />
            <input type="text" name="buscar" placeholder="Buscar">

            <input type="date" name="fechaInicio">

            <input type="date" name="fechaFin">

            <button type="submit" class="btn btn-warning text-white mx-2">
                Buscar
            </button>

        </form>
    </div>

    <table class="table table-bordered table-hover text-center align-middle" id="tablaInventario">

        <thead class="table-primary">
            <tr>
                <th>PRODUCTO</th>
                <th>LOTE</th>
                <th>TIPO</th>
                {{!-- <th>ESTADO</th> --}}
                <th>CANTIDAD</th>

                <th>FECHA DE REGISTRO</th>
                <th>ESTADO</th>

            
            </tr>
        </thead>

        <tbody>

            {{#each lista_inventario}}

                {{>card_inventario item=this}}
            
            
            {{/each}}
        </tbody>

    </table>
</div>
