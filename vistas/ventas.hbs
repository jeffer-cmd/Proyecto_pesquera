<h1>Gestión de ventas</h1>

<div class="d-flex justify-content-between align-items-center my-5  w-100 gap-3">

    <a class="btn btn-warning text-white my-5" href="/gestion_ventas/form_venta">Crear venta</a>

    <a href="/gestion_ventas/ventas_anuladas" class="btn btn-primary">
            Ventas anuladas
        </a>

    <input type="text" id="buscador" class="form-control mb-3 w-50 border border-dark" placeholder="Buscar lote">
    <form action="/gestion_ventas/ventas" method="POST">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        {{!-- <input type="text" name="usuario" placeholder="Buscar venta">

        <input type="date" name="fechaInicio">

        <input type="date" name="fechaFin">

        <button type="submit" class="btn btn-warning text-white mx-2">
            Buscar
        </button> --}}

    </form>
</div>



<table class="table table-bordered table-hover text-center align-middle" id="tablaVentas">

    <thead class="table-primary">
        <tr>
            <th>VENTA #</th>
            <th>VENDEDOR</th>
            <th>MÉTODO DE PAGO</th>
            <th>CLIENTE</th>
            <th>TOTAL</th>

            <th>FECHA DE REGISTRO</th>
            <th>ESTADO DE VENTA</th>
        
            <th class="" style="width: 150px;">ACCIONES</th>
        </tr>
    </thead>

    <tbody>

        {{#each lista_ventas}}

            {{>card_ventas item=this mostrarAcciones=true}}
        
        
        {{/each}}
    </tbody>

</table>

