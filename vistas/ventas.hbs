<h1>Gestión de ventas</h1>

<style>
    .input-busqueda {
        width: 250px;
    }

    @media (max-width: 991.98px) {

        .input-busqueda {
            width: 100%;
        }

    }
</style>


{{!-- <div class="d-flex justify-content-between align-items-center my-5  w-100 gap-3"> --}}
<div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-center">

    <a class="btn btn-warning text-white my-5" href="/gestion_ventas/form_venta">Crear venta</a>

    <a href="/gestion_ventas/ventas_anuladas" class="btn btn-primary">
            Ventas anuladas
    </a>

    {{!-- <input type="text" id="buscador" class="form-control mb-3 w-50 border border-dark" placeholder="Buscar venta"> --}}
    <form action="/gestion_ventas/ventas" method="POST" class="d-flex flex-column flex-lg-row gap-2 align-items-center">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />

        <input type="text" id="buscador" class="form-control my-4 input-busqueda  border border-dark" placeholder="Buscar venta">

        {{!-- <input type="text" name="usuario" placeholder="Buscar venta">

        <input type="date" name="fechaInicio">

        <input type="date" name="fechaFin">

        <button type="submit" class="btn btn-warning text-white mx-2">
            Buscar
        </button> --}}

    </form>
</div>


<div class="table-responsive">

    <table class="table table-sm table-bordered table-hover text-center align-middle" id="tablaVentas">

        <thead class="table-primary align-middle">
            <tr>
                <th>VENTA #</th>
                <th>VENDEDOR</th>
                <th>MÉTODO DE PAGO</th>
                <th>CLIENTE</th>
                <th>TOTAL</th>

                <th>FECHA DE REGISTRO</th>
                <th>ESTADO DE VENTA</th>
            
                <th class="" style="width: 150px;">ACCIONES</th>
            </tr>
        </thead>

        <tbody>

            {{#each lista_ventas}}

                {{>card_ventas item=this mostrarAcciones=true}}
            
            
            {{/each}}
        </tbody>

    </table>
</div>

<script src="/filtro_ventas.js"> </script>